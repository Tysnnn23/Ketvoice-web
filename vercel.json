{
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/player" }] },
    { "source": "/player.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ],
  "rewrites": [
    { "source": "/changelog", "destination": "/changelog.html" },
    { "source": "/listen", "destination": "/api/og-page?type=listen" },
    { "source": "/player", "destination": "/player.html" },
    { "source": "/ketmix", "destination": "/ketmix.html" },
    { "source": "/link", "destination": "/link/index.html" },
    { "source": "/artist/:id", "destination": "/api/og-page?type=artist&id=:id" },
    { "source": "/album/:id", "destination": "/api/og-page?type=album&id=:id" },
    { "source": "/u/:handle", "destination": "/api/og-page?type=profile&id=:handle" }
  ],
  "functions": {
    "api/og-page.js": { "includeFiles": "listen.html", "maxDuration": 10 }
  }
}
